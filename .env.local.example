# =============================================================================
# Supabase — required for all Supabase client connections.
# Get these values from: https://supabase.com/dashboard → project → Settings → API
#
# These NEXT_PUBLIC_ vars are safe to expose to the browser.
# They are locked down by Row Level Security (RLS) policies on the database.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# DO NOT add the service-role key here.
# The service-role key bypasses RLS and must NEVER be used client-side.
# It will be added to a secure server-only .env (e.g. .env.production.local)
# when admin server actions are implemented in a later phase.
# =============================================================================
